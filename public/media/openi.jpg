<script>
  ; (function () {
    
    const activeMenu = window.MENU_CONFIG.activeTopMenu;
    if (activeMenu) {
      document.querySelectorAll('#navbar-mobile .menu-item-c .menu-item').forEach(function (ele) {
        if (activeMenu == ele.getAttribute('key')) {
          ele.classList.add('focused')
        }
      })
    }

    if (window.MENU_CONFIG.showLeftMenu && window.MENU_CONFIG.activeLeftMenu) {
      const menuExpandElC = document.querySelector('#navbar-mobile > div.nav-left > div.menu-expand-btn-c')
      const menuExpandEl = document.querySelector('#navbar-mobile > div.nav-left > div.menu-expand-btn-c .menu-expand-btn')
      menuExpandElC.style.display = 'flex'
      menuExpandEl.querySelector('.close').style.display = 'inherit'
      if (document.documentElement.scrollWidth <= 1000) {
        window.MENU_CONFIG.collapseLeftMenu = true
        menuExpandEl.querySelector('.close').style.display = 'none'
        menuExpandEl.querySelector('.expand').style.display = 'inherit'
      }
      function toggle(e) {
        const navLeftEl = document.querySelector('#nav-left')
        const navLeftElC = document.querySelector('#nav-left-c')
        if (window.MENU_CONFIG.collapseLeftMenu) {
          menuExpandEl.querySelector('.expand').style.display = 'none'
          menuExpandEl.querySelector('.close').style.display = 'inherit'
          navLeftEl && navLeftEl.classList.remove('collapsed')
          navLeftElC && navLeftElC.classList.remove('collapsed')
          menuExpandEl.classList.remove('collapsed')
          if (document.querySelector('#navbar-mobile .nav-right').classList.contains('expanded')) {
            const evObj = document.createEvent('MouseEvents')
            evObj.initMouseEvent('click', true, true, window)
            document.querySelector('#navbar-mobile .nav-right svg').dispatchEvent(evObj)
          }
        } else {
          menuExpandEl.querySelector('.expand').style.display = 'inherit'
          menuExpandEl.querySelector('.close').style.display = 'none'
          navLeftEl && navLeftEl.classList.add('collapsed')
          navLeftElC && navLeftElC.classList.add('collapsed')
          menuExpandEl.classList.add('collapsed')
        }
        window.MENU_CONFIG.collapseLeftMenu = !window.MENU_CONFIG.collapseLeftMenu;
      }
      menuExpandEl.onclick = toggle
    }
    
    document.querySelector('#navbar-mobile .nav-right svg').addEventListener('click', function (e) {
      var target = e.target;
      while (!target.classList.contains('nav-right')) {
        target = target.parentNode
      }
      if (target.classList.contains('expanded')) {
        target.classList.remove('expanded')
        document.querySelector('#navbar-mobile .expand-pannel').style.height = '0'
        document.querySelector('#navbar-mobile .expand-pannel').style.minHeight = '0'
      } else {
        target.classList.add('expanded')
        var height = document.documentElement.scrollHeight
        document.querySelector('#navbar-mobile .expand-pannel').style.height = 'auto'
        document.querySelector('#navbar-mobile .expand-pannel').style.minHeight = (height - 60) + 'px'
      }
    });

    document.querySelectorAll('#navbar-mobile .sub-menu-c >.menu-item-c').forEach(function(ele){
      ele.addEventListener('click', function (e) {
        var target = e.target;
        while (!target.classList.contains('menu-item-c')) {
          target = target.parentNode
        }
        if (target.classList.contains('expanded')) {
          target.classList.remove('expanded')
          target.parentNode.querySelector('.sub-menu-list').style.height = '0'
        } else {
          target.classList.add('expanded')
          target.parentNode.querySelector('.sub-menu-list').style.height = 'auto'
        }
      });
    })

    document.querySelector('#navbar-mobile .expand-pannel').addEventListener('click', function(e) {
      if (e.target.classList.contains('expand-pannel')) {
        const evObj = document.createEvent('MouseEvents')
        evObj.initMouseEvent('click', true, true, window)
        document.querySelector('#navbar-mobile .nav-right svg').dispatchEvent(evObj)
      }
    })
  })();
</script>

