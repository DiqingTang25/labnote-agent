<script>
 ;(function () {
  document.querySelector('#navbar .menu-link.menu-link-expand .menu-expand-drop-btn-c').addEventListener('click', function(e) {
    var target = e.target;
    while (!target.classList.contains('menu-expand-drop-btn-c')) {
      target = target.parentNode
    }
    if (target.classList.contains('expanded')) {
      target.classList.remove('expanded')
      target.parentNode.querySelector('.menu-expand-pannel').style.height = '0'
    } else {    
      target.classList.add('expanded')
      target.parentNode.querySelector('.menu-expand-pannel').style.height = 'auto'
    }
  })

  document.querySelectorAll('#navbar .menu-link.menu-link-expand .menu-expand-pannel .menu-list .sub-menu-c >.menu-item-c').forEach(function(ele){
    ele.addEventListener('click', function (e) {
      var target = e.target;
      while (!target.classList.contains('menu-item-c')) {
        target = target.parentNode
      }
      if (target.classList.contains('expanded')) {
        target.classList.remove('expanded')
        target.parentNode.querySelector('.sub-menu-list').style.height = '0'
      } else {
        target.classList.add('expanded')
        target.parentNode.querySelector('.sub-menu-list').style.height = 'auto'
      }
    });
  })

  var containerElement = document.querySelector('#navbar .menu-link.menu-link-expand .menu-expand-pannel');
  var trigger = document.querySelector('#navbar .menu-link.menu-link-expand .menu-expand-drop-btn-c');
  document.addEventListener('click', function(event) {
    var targetElement = event.target;
    if (!containerElement.contains(targetElement) && !trigger.contains(targetElement)) {
      if (trigger.classList.contains('expanded')) {
        trigger.classList.remove('expanded')
        trigger.parentNode.querySelector('.menu-expand-pannel').style.height = '0'
      }
    }
  }, true);
 })();
</script>

	</div>
  
  <script>
    ; (function () {
      const activeMenu = window.MENU_CONFIG.activeTopMenu;
      if (activeMenu) {
        document.querySelectorAll('#navbar .menu-link .menu-item').forEach(function (ele) {
          if (activeMenu == ele.getAttribute('key')) {
            ele.classList.add('focused')
          }
        })
      }
      if ((window.MENU_CONFIG.showLeftMenu && window.MENU_CONFIG.activeLeftMenu) || window.MENU_CONFIG.activeTopMenu == 'modelbase') {
        const menuExpandElC = document.querySelector('#navbar > div.nav-left > div.menu-expand-btn-c')
        const menuExpandEl = document.querySelector('#navbar > div.nav-left > div.menu-expand-btn-c .menu-expand-btn')
				menuExpandElC.style.display = 'flex'
				menuExpandEl.querySelector('.close').style.display = 'inherit'
				menuExpandEl.onclick = function (e) {
					const navLeftEl = document.querySelector('#nav-left')
					if (window.MENU_CONFIG.collapseLeftMenu) {
						menuExpandEl.querySelector('.expand').style.display = 'none'
						menuExpandEl.querySelector('.close').style.display = 'inherit'
						navLeftEl && navLeftEl.classList.remove('collapsed')
					} else {
						menuExpandEl.querySelector('.expand').style.display = 'inherit'
						menuExpandEl.querySelector('.close').style.display = 'none'
						navLeftEl && navLeftEl.classList.add('collapsed')
					}
					window.MENU_CONFIG.collapseLeftMenu = !window.MENU_CONFIG.collapseLeftMenu;
				}
      }
    })()
  </script>
  
