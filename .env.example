# LabNote Agent 环境变量
# 复制此文件为 .env.local 并填入实际值
# Vercel: 在 Dashboard → Settings → Environment Variables 中设置
# Cloudflare Pages: 在 Dashboard → Settings → Environment variables 中设置

# ===== Supabase =====
# 服务端变量（无 VITE_ 前缀，不暴露给浏览器）
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>    # 从 Supabase Dashboard → Settings → API 获取
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# 客户端变量（VITE_ 前缀，对浏览器可见）
VITE_SUPABASE_URL=<your-supabase-project-url>
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ===== AI API（服务端）=====
# XJTLU AI Gateway 或任意 OpenAI 兼容 API
AI_API_KEY=<your-ai-chat-key>
# Embedding 模型 API Key（可能与 Chat 不同）
AI_EMBEDDING_KEY=<your-ai-embedding-key>
# 视觉模型 API Key（可能与 Chat 不同）
AI_VISION_KEY=<your-ai-vision-key>
# Reranker 模型 API Key（可能与 Chat 不同）
AI_RERANK_KEY=<your-ai-rerank-key>

# ===== Materials Project API（服务端）=====
# 从 https://materialsproject.org/dashboard 获取（免费注册）
# 用于论文拆解时查询材料属性（带隙、形成能、晶系等）增强置信度
MP_API_KEY=<your-materials-project-key>

# ===== HTTP 代理（服务端，可选）=====
# Node.js fetch() 不走系统代理。如需通过代理访问外部 API，
# 设置以下环境变量（Clash/Clash Verge 默认 http://127.0.0.1:7897）
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

